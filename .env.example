# ==================================================================================
# CONFIGURACION DEL SERVIDOR
# ==================================================================================
PORT=4000
SERVER_HOST=localhost

# Origenes permitidos para CORS (coma-separados). En produccion, lista blanca estricta.
# Ej: https://gemelo-front.vercel.app,https://gemelo.tu-dominio.com
CORS_ORIGINS=http://localhost:5173

# ==================================================================================
# CONFIGURACION ODOO ERP
# ==================================================================================
# NOTA: el codigo lee ODOO_DATABASE (no ODOO_DB). Usa exactamente este nombre.
ODOO_URL=https://tu-instancia-odoo.com
ODOO_DATABASE=blackdivision
ODOO_USERNAME=tu_usuario@dominio.com
ODOO_PASSWORD=tu_password_o_token

# ==================================================================================
# CONFIGURACION IA
# ==================================================================================
# OpenAI (ACTIVO - chat, reportes, packing analyzer)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic (legacy - dejar vacio tras migracion a OpenAI; eliminar cuando se limpie server.js)
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==================================================================================
# PERSISTENCIA (RAILWAY)
# ==================================================================================
# Solo en Railway con volumen montado. En local dejar vacio.
# RAILWAY_VOLUME_MOUNT_PATH=/var/data

# ==================================================================================
# CONFIGURACION OPCIONAL
# ==================================================================================
# NODE_ENV=production
# LOG_LEVEL=info
